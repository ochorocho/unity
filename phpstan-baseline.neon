parameters:
	ignoreErrors:
		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: lib/Service/IssueSyncService.php

		-
			message: '#^Offset ''c'' on array\{t\: string, c\: string, p\: array\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: lib/Service/IssueSyncService.php

		-
			message: '#^Parameter \#1 \$callback of method OCP\\IUserManager\:\:callForSeenUsers\(\) expects Closure\(OCP\\IUser\)\: \(bool\|null\), Closure\(OCP\\IUser\)\: void given\.$#'
			identifier: argument.type
			count: 1
			path: lib/Service/IssueSyncService.php

		-
			message: '#^Strict comparison using \=\=\= between non\-falsy\-string and '''' will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: lib/Service/Tracker/JiraClient.php
